{
    "manifests": {
        "nelmio/security-bundle": {
            "manifest": {
                "bundles": {
                    "Nelmio\\SecurityBundle\\NelmioSecurityBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                }
            },
            "files": {
                "config/packages/nelmio_security.yaml": {
                    "contents": [
                        "nelmio_security:",
                        "    # NOTE: Not enabled by default since it breaks logging in. Specify the cookies you want here manually.",
                        "    # See also https://github.com/nelmio/NelmioSecurityBundle#signed-cookies",
                        "    # signed_cookie:",
                        "    #     names:",
                        "    #         - Cookie1",
                        "    #         - Cookie2",
                        "",
                        "    clickjacking:",
                        "        paths:",
                        "            '^/.*': DENY",
                        "",
                        "    external_redirects:",
                        "        abort: true",
                        "        log: true",
                        "        allow_list:",
                        "            - sso.inventis.be",
                        "",
                        "    csp:",
                        "        hosts: [ ]",
                        "        content_types: [ ]",
                        "        enforce:",
                        "            block-all-mixed-content: true",
                        "            upgrade-insecure-requests: true",
                        "            level1_fallback: false",
                        "            browser_adaptive:",
                        "                enabled: false",
                        "            default-src:",
                        "                - 'data:'",
                        "                - self",
                        "                - https://youtube.com",
                        "                - https://*.youtube.com",
                        "                - https://youtu.be",
                        "                - https://*.youtu.be",
                        "                - https://*.ytimg.com",
                        "                - https://*.vimeo.com",
                        "                - https://*.vimeocdn.com",
                        "                - https://vimeo.com",
                        "                - https://*.spotify.com",
                        "                #- https://*.google.be",
                        "                #- https://*.google.nl",
                        "                #- https://*.google.fr",
                        "                #- https://*.google.de",
                        "                #- https://*.google.com",
                        "                #- https://*.google-analytics.com",
                        "                #- https://*.analytics.google.com",
                        "                #- https://*.googletagmanager.com",
                        "                #- https://*.googlesyndication.com",
                        "                #- https://*.doubleclick.net",
                        "                #- https://*.tiktok.com",
                        "                #- https://*.snapchat.com",
                        "                #- https://*.facebook.com",
                        "                #- https://*.facebook.net",
                        "            style-src:",
                        "                - self",
                        "                - 'unsafe-inline'",
                        "                #- https://*.googletagmanager.com",
                        "            script-src:",
                        "                - self",
                        "                - 'strict-dynamic'",
                        "                - 'unsafe-inline'",
                        "                - 'unsafe-eval'",
                        "            object-src:",
                        "                - none",
                        "",
                        "    content_type:",
                        "        nosniff: true",
                        "",
                        "    xss_protection:",
                        "        enabled: true",
                        "        mode_block: true",
                        "",
                        "    referrer_policy:",
                        "        enabled: true",
                        "        policies:",
                        "            - no-referrer",
                        "            - strict-origin-when-cross-origin",
                        "",
                        "    forced_ssl:",
                        "        hsts_max_age: 2592000 # 30 days",
                        "        hsts_subdomains: false",
                        "        redirect_status_code: 302",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "4bbfce18e315490c12e9165fe5307deda10ffbee"
        }
    }
}
